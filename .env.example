# Local only. Copy to .env and fill real values. Never commit .env.

# Supabase (frontend / Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Same values for SSR / server routes (no VITE_ prefix)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Server only (Vercel). Never put these in VITE_* vars.
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# SUPPORT_FORWARD_TO=

# Go sync / GitHub Actions only (never in the browser)
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# API_FOOTBALL_KEY=
# FOOTBALL_DATA_TOKEN=
